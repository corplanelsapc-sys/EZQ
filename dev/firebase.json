{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "kiosk-app/**",
      "*.zip",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/display",
        "destination": "/display.html"
      },
      {
        "source": "/staff",
        "destination": "/employee.html"
      },
      {
        "source": "/employee",
        "destination": "/employee.html"
      },
      {
        "source": "/customer",
        "destination": "/customer.html"
      },
      {
        "source": "/window",
        "destination": "/window.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
